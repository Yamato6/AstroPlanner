<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AstroPlanner.Core\AstroPlanner.Core.csproj" />
  </ItemGroup>

  <!-- Catálogos incrustados: el .exe publicado no depende de la carpeta SeedData. -->
  <ItemGroup>
    <None Remove="SeedData\*.json" />
    <EmbeddedResource Include="SeedData\messier_objects.json" LogicalName="SeedData/messier_objects.json" />
    <EmbeddedResource Include="SeedData\cities.json" LogicalName="SeedData/cities.json" />
  </ItemGroup>

</Project>
