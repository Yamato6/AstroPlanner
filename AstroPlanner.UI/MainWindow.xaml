<Window x:Class="AstroPlanner.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="AstroPlanner - Planificador Messier" Height="780" Width="1360" MinHeight="600" MinWidth="1000">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="12" Background="#172033" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="White" FontSize="22" FontWeight="SemiBold" Text="AstroPlanner"/>
                <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Foreground="#B8C7E0" Text="Latitud"/><TextBox Width="75" Text="{Binding Latitude, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Foreground="#B8C7E0" Text="Longitud"/><TextBox Width="75" Text="{Binding Longitude, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,10,0"><TextBlock Foreground="#B8C7E0" Text="Elevación (m)"/><TextBox Width="75" Text="{Binding Elevation, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,10,0"><TextBlock Foreground="#B8C7E0" Text="Fecha y hora"/><TextBox Width="145" Text="{Binding ObservationDateTime, StringFormat=dd/MM/yyyy HH:mm, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Grid.Column="5" Margin="0,0,10,0"><TextBlock Foreground="#B8C7E0" Text="Altitud mínima"/><TextBox Width="75" Text="{Binding MinimumAltitude, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <Button Grid.Column="6" Margin="0,16,10,0" Padding="10,4" Command="{Binding ResetFiltersCommand}" Content="Restablecer"/>
                <TextBlock Grid.Column="7" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#B8C7E0" Text="{Binding LocationSummary}"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,7,0" Padding="8" BorderBrush="#D5DAE3" BorderThickness="1" CornerRadius="6">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="0,0,7,0" VerticalAlignment="Center" Text="Tipo"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding TypeFilter}"/>
                        <CheckBox Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Content="Solo visibles" IsChecked="{Binding OnlyVisible}"/>
                    </Grid>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Objects}" SelectedItem="{Binding SelectedObject}">
                        <DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/><DataGridTextColumn Header="Nombre" Binding="{Binding CommonName}" Width="*"/><DataGridTextColumn Header="Constelación" Binding="{Binding Constellation}" Width="100"/><DataGridTextColumn Header="Mag." Binding="{Binding ApparentMagnitude, StringFormat=F1}" Width="50"/><DataGridTextColumn Header="Alt." Binding="{Binding AltitudeDegrees, StringFormat=F1}" Width="55"/><DataGridTextColumn Header="Az." Binding="{Binding AzimuthDegrees, StringFormat=F1}" Width="55"/><DataGridCheckBoxColumn Header="Visible" Binding="{Binding IsVisible}" Width="55"/></DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Margin="7,0,0,0" Padding="8" BorderBrush="#D5DAE3" BorderThickness="1" CornerRadius="6">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock FontSize="18" FontWeight="SemiBold" Text="Altitud durante la noche"/><ScottPlot:WpfPlot x:Name="AltitudePlot" Grid.Row="1" Margin="0,8,0,0"/></Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
