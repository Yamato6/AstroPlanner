<Window x:Class="AstroPlanner.UI.LogEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar observación"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#101A2B">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D7E3F4"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#AFC2DD"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Padding" Value="7,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,12,4"/>
            <Setter Property="Width" Value="60"/>
            <!-- Texto oscuro explícito: el estilo de TextBlock de la ventana (claro)
                 se aplicaría dentro del desplegable, que tiene fondo blanco. -->
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="Black"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="28">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Title}"/>
        <TextBlock Margin="0,4,0,18" Foreground="#8FA8C8" TextWrapping="Wrap"
                   Text="Anota la observación en tu bitácora. Seeing, transparencia y valoración: 1 = malo, 5 = excelente."/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="Fecha y hora"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                <DatePicker Width="140" Margin="0,4,8,4" SelectedDate="{Binding ObservedDate}" Language="es-MX"/>
                <TextBox Width="70" Text="{Binding ObservedTime, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Hora local, HH:mm"/>
            </StackPanel>

            <Label Grid.Row="1" Content="Lugar"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Row="2" Content="Equipo"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Equipment, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Telescopio, ocular, filtro… (se recuerda para la próxima)"/>

            <Label Grid.Row="3" Content="Condiciones"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Seeing" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding Scale}" SelectedItem="{Binding Seeing}"/>
                <TextBlock Text="Transparencia" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding Scale}" SelectedItem="{Binding Transparency}"/>
                <TextBlock Text="Valoración" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding Scale}" SelectedItem="{Binding Rating}"/>
            </StackPanel>

            <Label Grid.Row="4" Content="Notas" VerticalAlignment="Top" Margin="0,4,0,0"/>
            <TextBox Grid.Row="4" Grid.Column="1" Height="90" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <TextBlock x:Name="ErrorText" Margin="0,12,0,0" Foreground="#FFB3A7" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" IsCancel="True"/>
            <Button Content="Guardar" IsDefault="True" Click="OnSaveClicked"/>
        </StackPanel>
    </StackPanel>
</Window>
