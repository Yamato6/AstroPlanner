<Window x:Class="AstroPlanner.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración del observador"
        Width="620"
        SizeToContent="Height"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DialogBackgroundBrush}">
    <Window.Resources>
        <!-- Colores y plantillas: Themes/Dark.xaml -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource NightTextBrush}"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource LabelTextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBoxStyle}">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Padding" Value="7,5"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyle}">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource DarkCheckBoxStyle}">
            <Setter Property="Foreground" Value="{StaticResource NightTextBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <!-- Con clave, no implícito (igual que en LogEntryWindow). -->
        <Style x:Key="DialogButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Configuración del observador"/>
            <TextBlock Margin="0,4,0,22" Foreground="{StaticResource NightMutedTextBrush}"
                       Text="Elige una ciudad o introduce coordenadas personalizadas."/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="175"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Ciudad"/>
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding Cities}"
                          SelectedItem="{Binding SelectedCity}"
                          DisplayMemberPath="DisplayName"
                          IsEnabled="{Binding IsCitySelectionEnabled}"/>

                <Label Grid.Row="1" Content="Latitud (°)"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding Latitude, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsManualFieldsEnabled}"/>

                <Label Grid.Row="2" Content="Longitud (°)"/>
                <TextBox Grid.Row="2" Grid.Column="1"
                         Text="{Binding Longitude, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsManualFieldsEnabled}"/>

                <Label Grid.Row="3" Content="Elevación (m)"/>
                <TextBox Grid.Row="3" Grid.Column="1"
                         Text="{Binding Elevation, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsManualFieldsEnabled}"/>

                <Label Grid.Row="4" Content="Zona horaria"/>
                <ComboBox Grid.Row="4" Grid.Column="1"
                          ItemsSource="{Binding AvailableTimeZones}"
                          SelectedItem="{Binding SelectedTimeZone}"
                          DisplayMemberPath="Id"
                          IsEnabled="{Binding IsManualFieldsEnabled}"/>

                <Label Grid.Row="5" Content="Altitud mínima (°)"/>
                <TextBox Grid.Row="5" Grid.Column="1"
                         Text="{Binding MinimumAltitude, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="6" Content="Magnitud máxima"
                       ToolTip="Oculta los objetos más débiles que esta magnitud (mayor número = más débil)."/>
                <TextBox Grid.Row="6" Grid.Column="1"
                         Text="{Binding MaximumMagnitude, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Grid.Row="7" Grid.Column="1" HorizontalAlignment="Left" Margin="0,10,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Usar coordenadas manuales"
                        Command="{Binding UseManualLocationCommand}"/>
            </Grid>

            <!-- Funciones que usan internet: se pueden desactivar -->
            <TextBlock Margin="0,22,0,6" FontSize="15" FontWeight="SemiBold" Text="Conexión a internet"/>
            <CheckBox Margin="0,4" IsChecked="{Binding WeatherForecastEnabled}"
                      Content="Pronóstico de nubes (Open-Meteo)"/>
            <TextBlock Margin="23,2,0,8" Foreground="{StaticResource NightMutedTextBrush}" TextWrapping="Wrap" FontSize="12"
                       Text="Envía tu ubicación aproximada (redondeada a ~1 km) a open-meteo.com para obtener la nubosidad por horas."/>
            <CheckBox Margin="0,4" IsChecked="{Binding CheckForUpdates}"
                      Content="Buscar una versión nueva al iniciar (GitHub)"/>

            <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{StaticResource DangerSoftBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="{Binding StatusMessage}"/>
            </TextBlock>

            <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{StaticResource SuccessSoftBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="{Binding StatusMessage}"/>
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancelar" IsCancel="True" Click="OnCancelClicked" Style="{StaticResource DialogButtonStyle}"/>
                <Button Content="Guardar" IsDefault="True" Click="OnSaveClicked"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0" MinWidth="90"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
