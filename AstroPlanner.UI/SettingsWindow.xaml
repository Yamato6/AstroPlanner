<Window x:Class="AstroPlanner.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración del observador"
        Width="620"
        SizeToContent="Height"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#101A2B">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D7E3F4"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#AFC2DD"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Padding" Value="7,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Configuración del observador"/>
            <TextBlock Margin="0,4,0,22" Foreground="#8FA8C8"
                       Text="Elige una ciudad o introduce coordenadas personalizadas."/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="175"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Ciudad"/>
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding Cities}"
                          SelectedItem="{Binding SelectedCity}"
                          DisplayMemberPath="DisplayName"
                          IsEnabled="{Binding IsCitySelectionEnabled}"/>

                <Label Grid.Row="1" Content="Latitud (°)"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding Latitude, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsManualFieldsEnabled}"/>

                <Label Grid.Row="2" Content="Longitud (°)"/>
                <TextBox Grid.Row="2" Grid.Column="1"
                         Text="{Binding Longitude, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsManualFieldsEnabled}"/>

                <Label Grid.Row="3" Content="Elevación (m)"/>
                <TextBox Grid.Row="3" Grid.Column="1"
                         Text="{Binding Elevation, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsManualFieldsEnabled}"/>

                <Label Grid.Row="4" Content="Zona horaria"/>
                <ComboBox Grid.Row="4" Grid.Column="1"
                          ItemsSource="{Binding AvailableTimeZones}"
                          SelectedItem="{Binding SelectedTimeZone}"
                          DisplayMemberPath="Id"
                          IsEnabled="{Binding IsManualFieldsEnabled}"/>

                <Label Grid.Row="5" Content="Altitud mínima (°)"/>
                <TextBox Grid.Row="5" Grid.Column="1"
                         Text="{Binding MinimumAltitude, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" Margin="0,10,0,0"
                        Content="Usar coordenadas manuales"
                        Command="{Binding UseManualLocationCommand}"/>
            </Grid>

            <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#FFB3A7">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="{Binding StatusMessage}"/>
            </TextBlock>

            <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#8BE0B2">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="{Binding StatusMessage}"/>
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancelar" Click="OnCancelClicked"/>
                <Button Content="Guardar" IsDefault="True" Click="OnSaveClicked"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
